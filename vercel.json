{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "game-diary-app.vercel.app"
        }
      ],
      "destination": "https://gamediary.onimock.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gamediary.onimock.com"
        }
      ],
      "destination": "https://gamediary.onimock.com/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/(.*)",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/pt-BR",
      "destination": "/pt",
      "permanent": true
    },
    {
      "source": "/pt-BR/(.*)",
      "destination": "/pt/$1",
      "permanent": true
    },
    {
      "source": "/pt-br",
      "destination": "/pt",
      "permanent": true
    },
    {
      "source": "/pt-br/(.*)",
      "destination": "/pt/$1",
      "permanent": true
    },
    {
      "source": "/zh",
      "destination": "/cn",
      "permanent": true
    },
    {
      "source": "/zh/(.*)",
      "destination": "/cn/$1",
      "permanent": true
    },
    {
      "source": "/ja",
      "destination": "/jp",
      "permanent": true
    },
    {
      "source": "/ja/(.*)",
      "destination": "/jp/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/pt/tools", "destination": "/pt/tools/index.html" },
    { "source": "/pt/tools/(.*)", "destination": "/pt/tools/index.html" },
    { "source": "/pt/download", "destination": "/pt/download/index.html" },
    { "source": "/pt/download/(.*)", "destination": "/pt/download/index.html" },
    { "source": "/pt", "destination": "/pt/index.html" },
    { "source": "/pt/(.*)", "destination": "/pt/index.html" },

    { "source": "/es/tools", "destination": "/es/tools/index.html" },
    { "source": "/es/tools/(.*)", "destination": "/es/tools/index.html" },
    { "source": "/es/download", "destination": "/es/download/index.html" },
    { "source": "/es/download/(.*)", "destination": "/es/download/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/es/(.*)", "destination": "/es/index.html" },

    { "source": "/de/tools", "destination": "/de/tools/index.html" },
    { "source": "/de/tools/(.*)", "destination": "/de/tools/index.html" },
    { "source": "/de/download", "destination": "/de/download/index.html" },
    { "source": "/de/download/(.*)", "destination": "/de/download/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/de/(.*)", "destination": "/de/index.html" },

    { "source": "/fr/tools", "destination": "/fr/tools/index.html" },
    { "source": "/fr/tools/(.*)", "destination": "/fr/tools/index.html" },
    { "source": "/fr/download", "destination": "/fr/download/index.html" },
    { "source": "/fr/download/(.*)", "destination": "/fr/download/index.html" },
    { "source": "/fr", "destination": "/fr/index.html" },
    { "source": "/fr/(.*)", "destination": "/fr/index.html" },

    { "source": "/it/tools", "destination": "/it/tools/index.html" },
    { "source": "/it/tools/(.*)", "destination": "/it/tools/index.html" },
    { "source": "/it/download", "destination": "/it/download/index.html" },
    { "source": "/it/download/(.*)", "destination": "/it/download/index.html" },
    { "source": "/it", "destination": "/it/index.html" },
    { "source": "/it/(.*)", "destination": "/it/index.html" },

    { "source": "/ru/tools", "destination": "/ru/tools/index.html" },
    { "source": "/ru/tools/(.*)", "destination": "/ru/tools/index.html" },
    { "source": "/ru/download", "destination": "/ru/download/index.html" },
    { "source": "/ru/download/(.*)", "destination": "/ru/download/index.html" },
    { "source": "/ru", "destination": "/ru/index.html" },
    { "source": "/ru/(.*)", "destination": "/ru/index.html" },

    { "source": "/cn/tools", "destination": "/cn/tools/index.html" },
    { "source": "/cn/tools/(.*)", "destination": "/cn/tools/index.html" },
    { "source": "/cn/download", "destination": "/cn/download/index.html" },
    { "source": "/cn/download/(.*)", "destination": "/cn/download/index.html" },
    { "source": "/cn", "destination": "/cn/index.html" },
    { "source": "/cn/(.*)", "destination": "/cn/index.html" },

    { "source": "/jp/tools", "destination": "/jp/tools/index.html" },
    { "source": "/jp/tools/(.*)", "destination": "/jp/tools/index.html" },
    { "source": "/jp/download", "destination": "/jp/download/index.html" },
    { "source": "/jp/download/(.*)", "destination": "/jp/download/index.html" },
    { "source": "/jp", "destination": "/jp/index.html" },
    { "source": "/jp/(.*)", "destination": "/jp/index.html" },

    { "source": "/tools", "destination": "/tools/index.html" },
    { "source": "/tools/(.*)", "destination": "/tools/index.html" },
    { "source": "/download", "destination": "/download/index.html" },
    { "source": "/download/(.*)", "destination": "/download/index.html" },

    {
      "source": "/((?!assets/|favicon|robots|sitemap|og-image|api|google|pt|es|de|fr|it|ru|cn|jp).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
